# Copy to .env.local (dev) or Easypanel → App → Environment

# --- Meta Pixel (Facebook / Instagram ads) ---
# Events Manager → Data Sources → Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=
# Events Manager → Settings → Conversions API → Generate access token
META_CAPI_ACCESS_TOKEN=

# --- Google Analytics 4 ---
# Admin → Data Streams → Measurement ID (G-XXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Google Ads conversion (optional) ---
# Tools → Conversions → Tag setup → AW-XXXXXXXXX / label
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=

# --- OR Google Tag Manager (optional — if set, GA/Ads scripts above are skipped) ---
NEXT_PUBLIC_GTM_ID=

# --- Custom lead webhook (Make, Zapier, n8n, CRM, Google Sheets…) ---
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=
